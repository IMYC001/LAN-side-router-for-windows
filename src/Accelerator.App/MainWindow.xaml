<Window x:Class="Accelerator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Accelerator.App"
        Title="{local:Loc 局域网设备加速（旁路由模式）}" Width="800" Height="560" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" Icon="Assets/accelerator.ico"
        FontFamily="Microsoft YaHei UI" FontSize="12" Loaded="Window_Loaded">
  <Grid Background="{DynamicResource WindowBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TabControl x:Name="MainTabs" TabStripPlacement="Left" BorderThickness="0" SelectionChanged="MainTabs_SelectionChanged">
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
              <StackPanel IsItemsHost="True" Margin="0,22,0,0" KeyboardNavigation.TabIndex="1" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
            <Border Grid.Column="1" Padding="24,18,24,12">
              <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
            </Border>
          </Grid>
        </ControlTemplate>
      </TabControl.Template>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7FC;" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
            <TextBlock Text="{local:Loc '加速'}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer x:Name="ManualScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <local:DeviceCard x:Name="PrimaryCard"/>
            <ItemsControl x:Name="AdditionalDeviceCards">
              <ItemsControl.ItemTemplate>
                <DataTemplate><local:DeviceCard/></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem>
        <TabItem.Header><StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE968;" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
          <TextBlock Text="{local:Loc '多设备管理'}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
        </StackPanel></TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Grid Margin="0,0,0,20">
              <TextBlock Text="{local:Loc '多设备管理'}" Style="{StaticResource PageTitle}"/>
              <Button x:Name="AddDeviceButton" Style="{StaticResource PrimaryButton}" Click="AddDevice_Click" HorizontalAlignment="Right" Margin="0" ToolTip="{local:Loc '新增一台设备'}">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="&#xE710;" Margin="0,0,7,0"/><TextBlock Text="{local:Loc '添加设备'}"/></StackPanel>
              </Button>
            </Grid>
            <TextBlock Text="{local:Loc '每台设备有独立名称、节点和网络参数。新增设备会自动显示在加速页面。'}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,14"/>
            <ItemsControl x:Name="DeviceManagerList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,10">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{local:Loc '设备名称'}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" LostFocus="DeviceName_LostFocus" MaxLength="64"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="{local:Loc '加速节点'}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding DataContext.NodeOptions, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding SelectedNode, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="DeviceNode_Changed"/>
                      </StackPanel>
                      <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="DeleteDevice_Click" Tag="{Binding}" ToolTip="{local:Loc '删除此设备'}" VerticalAlignment="Bottom"><TextBlock Style="{StaticResource IconText}" Text="&#xE74D;"/></Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem>
        <TabItem.Header><StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F1;" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
          <TextBlock Text="{local:Loc '订阅'}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
        </StackPanel></TabItem.Header>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="{local:Loc '订阅'}" Style="{StaticResource PageTitle}" Margin="0,0,0,20"/>
          <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SubscriptionUrlBox" ToolTip="{local:Loc 'HTTPS 订阅地址'}" Margin="0,0,8,0"/>
            <Button Grid.Column="1" x:Name="FetchButton" Style="{StaticResource PrimaryButton}" Click="Fetch_Click">
              <TextBlock Text="{local:Loc '添加'}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
            <Button Grid.Column="2" x:Name="ImportButton" Click="Import_Click" Margin="0" ToolTip="{local:Loc '导入本地订阅文件'}">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;" Margin="0,0,6,0"/><TextBlock Text="{local:Loc '导入'}"/></StackPanel>
            </Button>
          </Grid>
          <TextBlock Grid.Row="2" x:Name="SubscriptionResult" Text="{local:Loc '尚未导入订阅'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,14"/>
          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="SubscriptionsList" SelectionChanged="Subscription_Changed" Background="{DynamicResource WindowBrush}"
                     Foreground="{DynamicResource TextBrush}" BorderThickness="0" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.Resources>
                <Style TargetType="ListBox">
                  <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ScrollViewer" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}"
                                      CanContentScroll="True" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                          <ItemsPresenter/>
                        </ScrollViewer>
                      </Border>
                    </ControlTemplate>
                  </Setter.Value></Setter>
                </Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
                  <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </Style>
              </ListBox.Resources>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Padding" Value="0"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Card" CornerRadius="6" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource WindowBrush}" Padding="12">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                          <Setter TargetName="Card" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value></Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}"/>
                    <TextBlock Text="{local:TranslatedBinding Source}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,6,0,8"/>
                    <TextBlock Text="{local:TranslatedBinding Usage, Format='已用 / 总额度：{0}'}" ToolTip="{local:TranslatedBinding UsageDetails}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                    <ProgressBar Value="{Binding UsagePercent, Mode=OneWay}" Height="3" Foreground="{DynamicResource AccentTextBrush}" Background="{DynamicResource SoftBrush}" BorderThickness="0" Margin="0,8,0,8"/>
                    <TextBlock Text="{local:TranslatedBinding Expiry}" Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{local:TranslatedBinding Updated}" ToolTip="{local:TranslatedBinding UsageDetails}" Foreground="{DynamicResource SubtleBrush}" FontSize="10" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Click="UpdateSubscription_Click" Tag="{Binding}" ToolTip="{local:Loc '更新订阅'}"><TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" FontSize="13"/></Button>
                        <Button Style="{StaticResource IconButton}" Click="RenameSubscription_Click" Tag="{Binding}" ToolTip="{local:Loc '重命名'}"><TextBlock Style="{StaticResource IconText}" Text="&#xE70F;" FontSize="13"/></Button>
                        <Button Style="{StaticResource IconButton}" Click="DeleteSubscription_Click" Tag="{Binding}" ToolTip="{local:Loc '删除订阅'}"><TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" FontSize="13"/></Button>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <DockPanel Grid.Column="2">
              <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="{local:Loc '节点'}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                <Button x:Name="LatencyButton" Click="Latency_Click" HorizontalAlignment="Right" Margin="0" Padding="8,4" MinHeight="28"
                        ToolTip="{local:Loc '测量电脑到节点服务器的延迟'}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE9D9;" FontSize="12" Margin="0,0,5,0"/>
                    <TextBlock x:Name="LatencyButtonText" Text="{local:Loc '测延迟'}" FontSize="11"/>
                  </StackPanel>
                </Button>
              </Grid>
              <TextBlock x:Name="LatencyNotice" DockPanel.Dock="Top" Visibility="Collapsed" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" Margin="0,0,0,8"/>
              <ListBox x:Name="NodesList" SelectionChanged="SubscriptionNode_Changed" Background="{DynamicResource WindowBrush}"
                       Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" Padding="4"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <ListBox.Resources>
                  <Style TargetType="ListBox">
                    <Setter Property="Template"><Setter.Value>
                      <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                          <ScrollViewer x:Name="PART_ScrollViewer" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}"
                                        CanContentScroll="True" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                        VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter/>
                          </ScrollViewer>
                        </Border>
                      </ControlTemplate>
                    </Setter.Value></Setter>
                  </Style>
                  <Style TargetType="ScrollViewer">
                    <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                  </Style>
                </ListBox.Resources>
                <ListBox.ItemTemplate><DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Margin="0,0,6,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{local:TranslatedBinding Display}" Foreground="{DynamicResource MutedBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="NoWrap" ToolTip="{local:TranslatedBinding Detail}"/>
                  </Grid>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem>
        <TabItem.Header><StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
          <TextBlock Text="{local:Loc '设置'}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
        </StackPanel></TabItem.Header>
        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{local:Loc '设置'}" Style="{StaticResource PageTitle}" Margin="0,0,0,14"/>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{local:Loc '外观主题'}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <RadioButton x:Name="LightThemeOption" Style="{StaticResource ThemeOption}" GroupName="Theme" Tag="Light" Checked="Theme_Changed" Margin="0,0,8,0">
                <TextBlock Text="{local:Loc '浅色'}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
              </RadioButton>
              <RadioButton x:Name="DarkThemeOption" Style="{StaticResource ThemeOption}" GroupName="Theme" Tag="Dark" Checked="Theme_Changed">
                <TextBlock Text="{local:Loc '深色'}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
              </RadioButton>
            </StackPanel>
          </Grid>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,10" Height="32">
            <TextBlock Text="{local:Loc '主题色'}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
            <StackPanel x:Name="AccentOptions" Orientation="Horizontal" HorizontalAlignment="Right">
              <RadioButton Style="{StaticResource AccentOption}" GroupName="Accent" Tag="Green" Background="#62D2B4" ToolTip="{local:Loc '绿色'}" AutomationProperties.Name="{local:Loc '绿色'}" Checked="Accent_Changed"/>
              <RadioButton Style="{StaticResource AccentOption}" GroupName="Accent" Tag="Blue" Background="#8BB8F3" ToolTip="{local:Loc '蓝色'}" AutomationProperties.Name="{local:Loc '蓝色'}" Checked="Accent_Changed"/>
              <RadioButton x:Name="SalmonAccentOption" Style="{StaticResource AccentOption}" GroupName="Accent" Tag="LightSalmon" Background="#FFA07A" ToolTip="{local:Loc '浅鲑红'}" AutomationProperties.Name="{local:Loc '浅鲑红'}" Checked="Accent_Changed"/>
              <RadioButton Style="{StaticResource AccentOption}" GroupName="Accent" Tag="Violet" Background="#C5A8F2" ToolTip="{local:Loc '紫色'}" AutomationProperties.Name="{local:Loc '紫色'}" Checked="Accent_Changed"/>
              <RadioButton Style="{StaticResource AccentOption}" GroupName="Accent" Tag="Rose" Background="#F298B5" ToolTip="{local:Loc '玫红色'}" AutomationProperties.Name="{local:Loc '玫红色'}" Checked="Accent_Changed"/>
            </StackPanel>
          </Grid>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{local:Loc 语言}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
            <ComboBox x:Name="LanguageBox" SelectedValuePath="Tag" SelectionChanged="Language_Changed"
                      HorizontalAlignment="Right" Width="164">
              <ComboBoxItem Tag="zh-CN" Content="简体中文"/>
              <ComboBoxItem Tag="en-US" Content="English"/>
            </ComboBox>
          </Grid>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="{local:Loc '窗口'}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
            <Button x:Name="TrayButton" Content="{local:Loc '收起到托盘'}" Click="Tray_Click" HorizontalAlignment="Right" Margin="0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentTextBrush}"/>
          </Grid>
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="{local:Loc '加速出口'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
              <ComboBox x:Name="OutletBox" SelectedIndex="1" SelectionChanged="Outlet_Changed">
                <ComboBoxItem Content="{local:Loc '现有 Clash / Mihomo'}"/><ComboBoxItem Content="{local:Loc '订阅独立节点'}"/>
              </ComboBox>
              <ComboBox x:Name="NodeBox" SelectionChanged="Node_Changed" Visibility="Collapsed"/>
              <TextBlock x:Name="OutletStatus" Text="{local:Loc '独立节点待准备'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8,0,0"/>
              <TextBlock x:Name="ClashWarning" Visibility="Collapsed" Text="{local:Loc '请将 Clash 切换为全局模式；规则模式可能让部分设备流量直连，导致加速失败。'}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" Margin="0,8,0,0"/>
              <StackPanel x:Name="ExistingProxyPanel" Margin="0,12,0,0">
                <TextBlock Text="{local:Loc '本机 SOCKS5 / Mixed 入口'}" Margin="0,0,0,6"/>
                <TextBox x:Name="ProxyBox" Text="127.0.0.1:7890" TextChanged="GatewayInput_Changed"/>
              </StackPanel>
              <TextBlock x:Name="ListenerText" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8,0,12"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="ProbeButton" Content="{local:Loc '检查 TCP / UDP'}" Click="Probe_Click" Margin="0,0,8,0"/>
                <Button x:Name="NATButton" Content="{local:Loc '检查 UDP 映射'}" Click="NATProbe_Click"/>
              </StackPanel>
              <TextBlock x:Name="TCPResult" Text="{local:Loc 'TCP · 未检查'}" Margin="0,10,0,5"/>
              <TextBlock x:Name="UDPResult" Text="{local:Loc 'UDP · 未检查'}"/>
              <TextBlock x:Name="ProbeScope" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8,0,0"/>
              <TextBlock x:Name="NATResult" Text="{local:Loc 'UDP 映射 · 未检查'}" FontSize="11" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,12">
            <StackPanel>
              <Grid Margin="0,0,0,10">
                <TextBlock Text="{local:Loc '网络与设备检测'}" Style="{StaticResource SectionTitle}"/>
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Click="Refresh_Click" ToolTip="{local:Loc '刷新网卡和已知设备'}" HorizontalAlignment="Right">
                  <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;"/>
                </Button>
              </Grid>
              <TextBlock Text="{local:Loc '局域网网卡'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
              <ComboBox x:Name="AdapterBox" DisplayMemberPath="Display" SelectionChanged="Adapter_Changed" Margin="0,0,0,8"/>
              <TextBlock x:Name="AdapterDetails" Text="{local:Loc '正在读取网络信息…'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,10"/>
              <DataGrid x:Name="DevicesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                        HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal" RowHeaderWidth="0" RowHeight="32" Height="132" Margin="0,0,0,10">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{local:Loc 'IP 地址'}" Binding="{Binding IP}" Width="1.15*"/>
                  <DataGridTextColumn Header="{local:Loc 'MAC 地址'}" Binding="{Binding MAC}" Width="1.5*"/>
                  <DataGridTextColumn Header="{local:Loc '状态'}" Binding="{local:TranslatedBinding State}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="DetectedDeviceText" Text="{local:Loc '设备 · 等待接入'}" FontSize="11"/>
              <CheckBox x:Name="IPv6Check" IsChecked="True" Margin="0,10,0,0" Checked="GatewayInput_Changed" Unchecked="GatewayInput_Changed">
                <TextBlock Text="{local:Loc '目标设备无可用公网 IPv6，使用 IPv4 加速'}" FontSize="11"/>
              </CheckBox>
            </StackPanel>
          </Border>
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <TextBlock Text="{local:Loc '诊断与日志'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
          </Border>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="ExportButton" Click="Export_Click">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" Margin="0,0,7,0"/><TextBlock Text="{local:Loc '导出诊断'}"/></StackPanel>
            </Button>
            <Button x:Name="SelfTestButton" Content="{local:Loc '离线验证'}" Click="SelfTest_Click"/>
          </StackPanel>
          <TextBlock x:Name="GatewaySpeedText" DockPanel.Dock="Top" Text="{local:Loc '捕获丢包 · 等待开始'}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
          <TextBlock x:Name="GatewayTrafficText" DockPanel.Dock="Top" Text="{local:Loc 'UDP 会话 · 等待开始'}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
          <TextBlock x:Name="GatewayDiagnosticsText" DockPanel.Dock="Top" Text="{local:Loc '运行诊断 · 等待开始'}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
          <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   VerticalContentAlignment="Top" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11"
                   Background="{DynamicResource FieldBrush}" BorderThickness="0" Padding="10" MinHeight="110"/>
        </DockPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="AboutTab">
        <TabItem.Header><StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
          <TextBlock Text="{local:Loc 关于}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
        </StackPanel></TabItem.Header>
        <Grid>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="AboutIcon" Source="Assets/accelerator.ico" Width="88" Height="88" Margin="0,0,0,18"/>
            <TextBlock Text="{local:Loc 局域网设备加速器}" FontSize="22" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,14"/>
            <TextBlock TextAlignment="Center" Margin="0,0,0,12">
              <Hyperlink x:Name="ProjectLink" NavigateUri="https://github.com/IMYC001/LAN-side-router-for-windows"
                         RequestNavigate="ProjectLink_RequestNavigate" Foreground="{DynamicResource AccentTextBrush}">
                <Run Text="https://github.com/IMYC001/LAN-side-router-for-windows"/>
              </Hyperlink>
            </TextBlock>
            <TextBlock Text="QQ3524829413" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
            <TextBlock Text="{local:Loc 特别鸣谢：GPT 6 Astra}" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,6">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0">
          <TextBlock x:Name="SafetyText" Text="{local:Loc '未启动 · 填写前记录设备原设置'}" Foreground="{DynamicResource MutedBrush}" FontSize="10"
                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          <TextBlock x:Name="StatusText" Text="{local:Loc '准备就绪'}" Foreground="{DynamicResource SubtleBrush}" FontSize="10" Margin="0,2,0,0"
                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="0.5.14" Foreground="{DynamicResource SubtleBrush}" FontSize="10" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
